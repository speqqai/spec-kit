{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "SPEQQ_HOOK_AGENT=claude-code \"${CLAUDE_PLUGIN_ROOT}/skills/spec-setup/hooks/session-start.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "SPEQQ_HOOK_AGENT=claude-code \"${CLAUDE_PLUGIN_ROOT}/skills/spec-setup/hooks/spec-context-watch.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "SPEQQ_HOOK_AGENT=claude-code \"${CLAUDE_PLUGIN_ROOT}/skills/spec-setup/hooks/spec-memory.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SPEQQ_HOOK_AGENT=claude-code \"${CLAUDE_PLUGIN_ROOT}/skills/spec-setup/hooks/spec-memory.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
