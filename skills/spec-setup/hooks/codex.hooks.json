{
  "description": "Speqq session context at session start; memory writes at compaction and session end (Codex >= 0.124.0).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/skills/spec-setup/hooks/session-start.sh",
            "statusMessage": "Connecting to Speqq",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/skills/spec-setup/hooks/session-start.sh",
            "statusMessage": "Refreshing Speqq context",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "SPEQQ_HOOK_AGENT=codex ./.claude/skills/spec-setup/hooks/spec-memory.sh",
            "statusMessage": "Recording Speqq memory",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SPEQQ_HOOK_AGENT=codex ./.claude/skills/spec-setup/hooks/spec-memory.sh",
            "statusMessage": "Recording Speqq memory",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
