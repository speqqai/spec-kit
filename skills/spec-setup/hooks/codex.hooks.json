{
  "description": "Speqq session context at session start; memory writes at compaction and session end; checkpoint ladder as context fills. Codex floors: SessionStart >= 0.114.0 (compact source >= 0.133.0), PreCompact/PostToolUse >= 0.129.0, SessionEnd >= 0.145.0.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "SPEQQ_HOOK_AGENT=codex ./.agents/skills/spec-setup/hooks/session-start.sh",
            "statusMessage": "Connecting to Speqq",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "SPEQQ_HOOK_AGENT=codex ./.agents/skills/spec-setup/hooks/session-start.sh",
            "statusMessage": "Refreshing Speqq context",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "SPEQQ_HOOK_AGENT=codex ./.agents/skills/spec-setup/hooks/spec-memory.sh",
            "statusMessage": "Recording Speqq memory",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SPEQQ_HOOK_AGENT=codex ./.agents/skills/spec-setup/hooks/spec-memory.sh",
            "statusMessage": "Recording Speqq memory",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "SPEQQ_HOOK_AGENT=codex ./.agents/skills/spec-setup/hooks/spec-context-watch.sh",
            "statusMessage": "Speqq checkpoint",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
